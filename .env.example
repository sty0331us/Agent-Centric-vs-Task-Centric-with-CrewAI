# -----------------------------------------------------------------------------
# Daily Dish Chatbot — environment template
# Copy to .env and fill in values before running.
# -----------------------------------------------------------------------------

# Required: LLM provider key (OpenAI-compatible by default for CrewAI)
OPENAI_API_KEY=sk-your-key-here

# Optional overrides
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_API_BASE=

# Crew / runtime
DAILY_DISH_LOG_LEVEL=INFO
DAILY_DISH_VERBOSE=true
DAILY_DISH_DEFAULT_MODE=task_centric
DAILY_DISH_FAQ_PDF_PATH=data/faqs/daily_dish_faq.pdf
DAILY_DISH_MAX_QUERY_CHARS=500
DAILY_DISH_MEMORY_TURNS=3

# Optional: Serper / web search (used by web-search tool when enabled)
SERPER_API_KEY=
